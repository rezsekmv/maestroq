{
  "name": "maestroq-monorepo",
  "version": "0.1.0",
  "description": "Local job queue/daemon for Maestro UI tests — share simulators/emulators across parallel worktrees and AI coding agents.",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "tsc -b --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.19.19",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
